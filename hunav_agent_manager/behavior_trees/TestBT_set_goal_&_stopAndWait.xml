<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="GoToTree" BTCPP_format="4">
  <TreeNodesModel>
    <Action ID="SetGoal">
      <input_port name="agent_id" type="int">Identifier of the agent</input_port>
      <input_port name="target_x" type="double">X coordinate of the goal</input_port>
      <input_port name="target_y" type="double">Y coordinate of the goal</input_port>
    </Action>
    <Action ID="StopAndWaitTimerAction">
      <input_port name="agent_id" type="int">identifier of the agent</input_port>
      <input_port name="wait_duration" type="double">3.0</input_port>
    </Action>
    <Action ID="RegularNav">
      <input_port name="agent_id" type="int">Identifier of the agent</input_port>
      <input_port name="time_step" type="double">Time step (seconds) for movement computation</input_port>
    </Action>
    <Action ID="UpdateGoal">
      <input_port name="agent_id" type="int">Identifier of the agent</input_port>
    </Action>
    <Condition ID="IsGoalReached">
      <input_port name="agent_id" type="int">Identifier of the agent</input_port>
    </Condition>
  </TreeNodesModel>


  <BehaviorTree ID="GoToTree">
    <Fallback name="MainFallback">
      <Sequence name="RegularNavigation">
        <RunOnce>
          <SetGoal agent_id="{id}" target_x="1.0" target_y="1.0" />
        </RunOnce>
        <Inverter>
          <IsGoalReached agent_id="{id}" />
        </Inverter>
        <RegularNav agent_id="{id}" time_step="{dt}" />
      </Sequence>
      <RunOnce>
        <StopAndWaitTimerAction agent_id="{id}" wait_duration="5.0"/>
      </RunOnce>
      <UpdateGoal agent_id="{id}" />
    </Fallback>
  </BehaviorTree>
</root>