<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="ConversationTree" BTCPP_format="4">
  <TreeNodesModel>
    <Action ID="RegularNav">
      <input_port name="agent_id" type="int"/>
      <input_port name="time_step" type="double"/>
    </Action>
    <Action ID="UpdateGoal">
      <input_port name="agent_id" type="int"/>
    </Action>
    <Condition ID="IsGoalReached">
      <input_port name="agent_id" type="int"/>
    </Condition>
    <Condition ID="TimeExpiredCondition">
      <input_port name="seconds" type="double">duration of the timer in seconds</input_port>
      <input_port name="ts" type="double">time step to be accumulated</input_port>
      <input_port name="only_once" type="bool">boolean to indicate if the timer must be reset at the end or not</input_port>
    </Condition>
    <Action ID="ConversationFormation">
      <input_port name="main_agent_id" type="int">1</input_port>
      <input_port name="conversation_duration" type="double" default="10.0"/>
      <input_port name="center_x" type="double" default="5.0"/>
      <input_port name="center_y" type="double" default="5.0"/>
      <input_port name="time_step" type="double" default="0.1"/>
      <input_port name="non_main_agent_ids" type="std::string"/>
    </Action>
  </TreeNodesModel>
  
  <BehaviorTree ID="ConversationTree">
    <Fallback name="MainFallback">
      <Sequence name="RegularNavigation">
        <TimeDelay delay="15.0">
          <Inverter>
            <RunOnce> 
              <ConversationFormation main_agent_id="{id}"
                                    time_step="{dt}"
                                    conversation_duration="5"
                                    center_x="0.5"
                                    center_y="-2.0"
                                    non_main_agent_ids="1,3,4"/>                  
            </RunOnce>
          </Inverter>
        </TimeDelay>
      </Sequence>
      <Sequence name="RegularNavigation">
        <Inverter>
          <IsGoalReached agent_id="{id}"/>
        </Inverter>
        <RegularNav agent_id="{id}" time_step="{dt}"/>
      </Sequence>
      <UpdateGoal agent_id="{id}"/>
    </Fallback>
  </BehaviorTree>
</root>
