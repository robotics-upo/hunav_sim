<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="GoToTree2" BTCPP_format="4">
  <TreeNodesModel>
    <Action ID="GoTo">
      <input_port name="agent_id" type="int">Identifier of the agent</input_port>
      <input_port name="target_x" type="double">X coordinate of the goal</input_port>
      <input_port name="target_y" type="double">Y coordinate of the goal</input_port>
      <input_port name="time_step" type="double">Time step for navigation updates</input_port>
      <input_port name="temporary" type="bool" default="true">Set true for a temporary goal</input_port>
      <input_port name="stop_duration" type="double" default="5.0">Duration to freeze agent for temporary goal</input_port>
    </Action>
    <Action ID="RegularNav">
      <input_port name="agent_id" type="int">Identifier of the agent</input_port>
      <input_port name="time_step" type="double">Time step (seconds) for movement computation</input_port>
    </Action>
    <Action ID="UpdateGoal">
      <input_port name="agent_id" type="int">Identifier of the agent</input_port>
    </Action>
    <Condition ID="IsGoalReached">
      <input_port name="agent_id" type="int">Identifier of the agent</input_port>
    </Condition>
  </TreeNodesModel>


  <BehaviorTree ID="GoToTree2">
    <Fallback name="MainFallback">
      <Sequence name="RegularNavigation">
        <RunOnce>
          <GoTo agent_id="{id}" target_x="1.5" target_y="1.5" 
                time_step="{dt}" temporary="false" stop_duration="5.0" />
        </RunOnce>
        <Inverter>
          <IsGoalReached agent_id="{id}" />
        </Inverter>
        <RegularNav agent_id="{id}" time_step="{dt}" />
      </Sequence>
      <UpdateGoal agent_id="{id}" />
    </Fallback>
  </BehaviorTree>
</root>