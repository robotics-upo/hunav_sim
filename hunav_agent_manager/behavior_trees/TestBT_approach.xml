<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="GroupWalkTree" BTCPP_format="4">
  <TreeNodesModel>
    <Action ID="RegularNav">
      <input_port name="agent_id" type="int"/>
      <input_port name="time_step" type="double"/>
    </Action>
    <Action ID="UpdateGoal">
      <input_port name="agent_id" type="int"/>
    </Action>
    <Condition ID="IsGoalReached">
      <input_port name="agent_id" type="int"/>
    </Condition>
    <Condition ID="TimeExpiredCondition">
        <input_port name="seconds" type="double">duration of the timer in seconds</input_port>
        <input_port name="ts" type="double">time step to be accumulated</input_port>
        <input_port name="only_once" type="bool">boolean to indicate if the timer must be reset at the end or not</input_port>
    </Condition>
    <Action ID="ApproachAgent">
      <input_port name="agent_id" type="int"/>
      <input_port name="time_step" type="double"/>
      <input_port name="target_agent_id" type="int"/>
      <input_port name="close_distance" type="double"/>
      <input_port name="approach_vel" type="double"/>
    </Action>
    <Action ID="ApproachAgentStateful">
      <input_port name="agent_id" type="int"/>
      <input_port name="target_agent_id" type="int"/>
      <input_port name="time_step" type="double"/>
      <input_port name="duration" type="double" />
    </Action>
    <Action ID="ApproachRobot">
      <input_port name="agent_id" type="int">1</input_port>
      <input_port name="time_step" type="double" />
      <input_port name="closest_dist" type="double" />
      <input_port name="max_vel" type="double" />
      <input_port name="duration" type="double" />
    </Action>
  </TreeNodesModel>

<BehaviorTree ID="GroupWalkTree">
    <Fallback name="MainFallback">
      <!-- <Sequence name="Approach"> 
        <ApproachAgent agent_id="{id}" time_step="{dt}" target_agent_id="1" close_distance="1.0" approach_vel="1.5"/>  
        <Inverter>
          <RunOnce>
            <ApproachAgentStateful agent_id="{id}" target_agent_id="1" 
                                  time_step="{dt}" duration="30.0"/>
          </RunOnce>
        </Inverter>

      </Sequence> -->

      <Sequence name="RegularNavigation">
        <RunOnce>
          <!-- <ApproachAgentStateful agent_id="{id}" target_agent_id="1" 
                                time_step="{dt}" duration="15.0"/> -->
          <ApproachRobot agent_id="{id}" time_step="{dt}" closest_dist="2.0" max_vel="1.5" duration="20.0"/>
        </RunOnce>

        <Inverter>
          <IsGoalReached agent_id="{id}"/>
        </Inverter>
        <RegularNav agent_id="{id}" time_step="{dt}"/>
      </Sequence>
      <UpdateGoal agent_id="{id}"/>
    </Fallback>
  </BehaviorTree>
</root>

